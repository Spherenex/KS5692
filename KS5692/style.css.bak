:root {
  --canvas: #080a12;
  --canvas-soft: #101421;
  --sidebar: #0c101b;
  --surface: #141a28;
  --surface-raised: #192131;
  --surface-hover: #202b3e;
  --border: #2a3448;
  --border-bright: #3c4b66;
  --text: #f4f7fb;
  --text-secondary: #a6b2c5;
  --text-muted: #718098;
  --primary: #6c7cff;
  --primary-bright: #8c98ff;
  --telemetry: #20d6c7;
  --success: #2fd69b;
  --warning: #ffb84d;
  --danger: #ff637d;
  --purple: #bd83ff;
  --shadow: 0 18px 45px rgba(0, 0, 0, .22);
  --radius: 14px;
}

* {
  box-sizing: border-box;
}

html,
body,
#react-entry-point {
  min-height: 100%;
  margin: 0;
}

body {
  overflow-x: hidden;
  background:
    radial-gradient(circle at 88% -10%, rgba(108, 124, 255, .18), transparent 32rem),
    radial-gradient(circle at 34% 110%, rgba(32, 214, 199, .09), transparent 28rem),
    var(--canvas);
  color: var(--text);
  font-family: Inter, "Segoe UI", sans-serif;
}

/* Sidebar */
.sidebar {
  position: fixed;
  inset: 0 auto 0 0;
  z-index: 20;
  width: 288px;
  padding: 26px 22px;
  overflow-y: auto;
  background: linear-gradient(180deg, rgba(17, 22, 36, .98), rgba(10, 13, 23, .99));
  border-right: 1px solid var(--border);
  box-shadow: 18px 0 50px rgba(0, 0, 0, .18);
  scrollbar-width: thin;
  scrollbar-color: #46526a transparent;
}

.brand {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-bottom: 28px;
}

.brand b {
  display: block;
  color: #fff;
  font-size: 20px;
  letter-spacing: .2px;
}

.brand small {
  display: block;
  margin-top: 4px;
  color: var(--text-secondary);
  letter-spacing: 3px;
}

.logo {
  width: 50px;
  height: 50px;
  display: grid;
  place-items: center;
  flex: 0 0 auto;
  color: var(--telemetry);
  font-weight: 800;
  font-size: 18px;
  border: 1px solid rgba(32, 214, 199, .7);
  border-radius: 15px;
  background: linear-gradient(145deg, rgba(32, 214, 199, .12), rgba(108, 124, 255, .08));
  box-shadow: inset 0 0 20px rgba(32, 214, 199, .06), 0 0 24px rgba(32, 214, 199, .08);
}

.sidebar>label {
  display: block;
  margin: 16px 0 8px;
  color: #8492aa;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 1.35px;
}

.sidebar hr {
  margin: 20px 0 15px;
  border: 0;
  border-top: 1px solid var(--border);
}

.disclaimer {
  margin-top: 24px;
  color: #6f7c91;
  font-size: 10px;
  line-height: 1.55;
}

/* Sidebar contrast: override component-library defaults */
.sidebar {
  color: #f8fbff;
}

.sidebar .brand b {
  color: #ffffff !important;
}

.sidebar .brand small {
  color: #c5d3e6 !important;
}

.sidebar>label {
  color: #8fdcf6 !important;
}

.sidebar .disclaimer {
  color: #a8b7cb !important;
}

.sidebar button {
  color: #ffffff !important;
}

.sidebar .nav,
.sidebar .nav label,
.sidebar .nav label span,
.sidebar .nav label.nav-item,
.sidebar .nav label.nav-item span {
  color: #e5edf8 !important;
  opacity: 1 !important;
}

.sidebar .nav label.nav-item:has(input:checked),
.sidebar .nav label.nav-item:has(input:checked) span {
  color: #ffffff !important;
  font-weight: 700 !important;
}

.sidebar .dark-dropdown,
.sidebar .dark-dropdown * {
  opacity: 1 !important;
  color: #14243a !important;
}

.sidebar .dark-dropdown .Select-value-label,
.sidebar .dark-dropdown .Select-placeholder,
.sidebar .dark-dropdown .Select-input,
.sidebar .dark-dropdown .Select-input>input,
#mode .Select-value-label,
#capacity .Select-value-label,
#speed .Select-value-label {
  color: #14243a !important;
  -webkit-text-fill-color: #14243a !important;
}

.sidebar .dark-dropdown .VirtualizedSelectOption,
.sidebar .dark-dropdown .VirtualizedSelectFocusedOption {
  color: #ffffff !important;
  -webkit-text-fill-color: #ffffff !important;
}

/* Dash dropdowns */
.dark-dropdown {
  color: var(--text) !important;
}

.dark-dropdown .Select-control,
.dark-dropdown.is-focused .Select-control {
  height: 44px !important;
  background: var(--surface) !important;
  border: 1px solid var(--border-bright) !important;
  border-radius: 10px !important;
  box-shadow: none !important;
  transition: border-color .2s, background .2s, box-shadow .2s;
}

.dark-dropdown:hover .Select-control,
.dark-dropdown.is-focused .Select-control {
  background: var(--surface-raised) !important;
  border-color: var(--primary) !important;
  box-shadow: 0 0 0 3px rgba(108, 124, 255, .12) !important;
}

.dark-dropdown .Select-value,
.dark-dropdown .Select-placeholder,
.dark-dropdown .Select-input {
  line-height: 42px !important;
}

.dark-dropdown .Select-value-label,
.dark-dropdown .Select-placeholder,
.dark-dropdown .Select-input,
.dark-dropdown .Select-input>input {
  color: var(--text) !important;
  font-size: 13px !important;
  font-weight: 600 !important;
}

.dark-dropdown .Select-arrow {
  border-top-color: var(--text-secondary) !important;
}

.dark-dropdown .Select-menu-outer {
  z-index: 1000;
  margin-top: 5px;
  overflow: hidden;
  background: var(--surface-raised) !important;
  border: 1px solid var(--border-bright) !important;
  border-radius: 10px !important;
  box-shadow: var(--shadow);
}

.dark-dropdown .VirtualizedSelectOption {
  background: var(--surface-raised) !important;
  color: var(--text) !important;
}

.dark-dropdown .VirtualizedSelectFocusedOption {
  background: var(--surface-hover) !important;
  color: var(--telemetry) !important;
}

/* Sidebar controls and navigation */
.controls {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 9px;
  margin-top: 20px;
}

button,
.download {
  min-height: 40px;
  padding: 10px 13px;
  cursor: pointer;
  color: #fff;
  background: linear-gradient(145deg, #25304a, #1c2539);
  border: 1px solid #3c4b67;
  border-radius: 10px;
  font: 700 10px Inter, sans-serif;
  letter-spacing: .45px;
  text-decoration: none;
  transition: transform .16s, border-color .16s, background .16s, box-shadow .16s;
}

button:hover,
.download:hover {
  transform: translateY(-1px);
  background: linear-gradient(145deg, #34415f, #27344e);
  border-color: var(--primary-bright);
  box-shadow: 0 8px 20px rgba(0, 0, 0, .2);
}

button:active {
  transform: translateY(0);
}

button:disabled {
  opacity: .42;
  cursor: not-allowed;
  transform: none;
  box-shadow: none;
}

.controls button:first-child {
  color: #07130f;
  background: var(--success);
  border-color: var(--success);
}

.controls button:last-child {
  color: #ffdce2;
  border-color: rgba(255, 99, 125, .55);
}

.nav {
  display: flex !important;
  flex-direction: column;
  gap: 3px;
}

.nav label.nav-item {
  display: flex !important;
  align-items: center;
  gap: 10px;
  width: 100%;
  margin: 0 !important;
  padding: 9px 10px !important;
  color: var(--text-secondary) !important;
  border: 1px solid transparent;
  border-radius: 9px;
  font-size: 12px;
  line-height: 1.2;
  transition: color .16s, background .16s, border-color .16s;
}

.nav label.nav-item:hover {
  color: #fff !important;
  background: var(--surface);
  border-color: var(--border);
}

.nav input[type=radio] {
  margin: 0;
  flex: 0 0 auto;
  accent-color: var(--primary);
}

.nav label.nav-item:has(input:checked) {
  color: #fff !important;
  background: rgba(108, 124, 255, .14);
  border-color: rgba(108, 124, 255, .35);
}

/* Main content */
.main {
  min-height: 100vh;
  margin-left: 288px;
  padding: 28px clamp(22px, 3vw, 46px) 50px;
}

#content {
  min-height: 520px;
  overflow-anchor: none;
}

header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 28px;
  padding-bottom: 20px;
  border-bottom: 1px solid var(--border);
}

h1 {
  margin: 0;
  color: #fff;
  font-size: clamp(22px, 2.2vw, 34px);
  line-height: 1.18;
  letter-spacing: -.8px;
}

h2 {
  margin: 4px 0 18px;
  color: #f8faff;
  font-size: clamp(19px, 1.6vw, 25px);
  letter-spacing: -.35px;
}

header p {
  margin: 8px 0 0;
  color: var(--text-secondary);
  font-size: clamp(12px, 1.1vw, 16px);
}

#status {
  flex: 0 0 auto;
  color: var(--text-secondary);
  font: 700 12px JetBrains Mono, monospace;
  letter-spacing: .7px;
}

.muted {
  color: var(--text-muted);
}

/* KPIs */
.kpi-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(155px, 1fr));
  gap: 13px;
  margin: 18px 0;
}

.kpi {
  position: relative;
  min-height: 96px;
  padding: 17px;
  overflow: hidden;
  background: linear-gradient(145deg, rgba(27, 35, 52, .97), rgba(18, 24, 38, .97));
  border: 1px solid var(--border);
  border-radius: var(--radius);
  box-shadow: 0 10px 28px rgba(0, 0, 0, .12);
}

.kpi::after {
  content: "";
  position: absolute;
  inset: auto 0 0;
  height: 2px;
  background: linear-gradient(90deg, transparent, rgba(108, 124, 255, .7), transparent);
  opacity: .45;
}

.kpi small {
  display: block;
  margin-bottom: 12px;
  color: var(--text-secondary);
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 1px;
  text-transform: uppercase;
}

.kpi strong {
  display: block;
  font-size: clamp(17px, 1.4vw, 22px);
  line-height: 1.15;
  overflow-wrap: anywhere;
}

.cyan {
  color: var(--primary-bright);
}

.green {
  color: var(--success);
}

.amber {
  color: var(--warning);
}

.red {
  color: var(--danger);
}

.violet {
  color: var(--purple);
}

.muted {
  color: var(--text-muted);
}

/* Architecture and content panels */
.flow {
  display: flex;
  align-items: stretch;
  gap: 8px;
  width: 100%;
  padding: 18px;
  overflow-x: auto;
  background: rgba(17, 22, 35, .8);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  scroll-snap-type: x proximity;
}

.node {
  display: flex;
  flex: 1 1 0;
  min-width: 105px;
  min-height: 96px;
  padding: 13px 8px;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  text-align: center;
  scroll-snap-align: start;
  background: linear-gradient(155deg, #1a2436, #111826);
  border: 1px solid #34435d;
  border-radius: 12px;
}

.node b {
  color: #f7f9fd;
  font-size: 13px;
  line-height: 1.35;
}

.node span {
  display: block;
  margin-top: 8px;
  color: var(--success);
  font: 600 9px JetBrains Mono, monospace;
}

.node.active {
  position: relative;
  border-color: rgba(32, 214, 199, .62);
  box-shadow: 0 0 0 1px rgba(32, 214, 199, .08), 0 0 24px rgba(32, 214, 199, .1);
}

.node.active::after {
  content: "";
  position: absolute;
  top: 9px;
  right: 9px;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--success);
  animation: status-pulse 1.8s ease-out infinite;
}

.arrow {
  align-self: center;
  flex: 0 0 auto;
  color: var(--telemetry);
  font-size: 22px;
}

.strip,
.panel,
.warning {
  margin: 15px 0;
  padding: 17px;
  background: rgba(20, 26, 40, .92);
  border: 1px solid var(--border);
  border-radius: 12px;
}

.strip small {
  display: block;
  margin-bottom: 8px;
  color: var(--text-muted);
  font-size: 10px;
  letter-spacing: 1px;
}

.strip code {
  color: var(--telemetry);
  font-family: JetBrains Mono, monospace;
}

.panel summary {
  cursor: pointer;
  color: #e4e9f2;
  font-weight: 600;
}

.panel p {
  color: var(--text-secondary);
  line-height: 1.65;
}

.warning {
  color: #ffd591;
  background: rgba(255, 184, 77, .08);
  border-color: rgba(255, 184, 77, .4);
}

/* Charts, tables, actions, logs */
.two {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 15px;
}

.chart {
  width: 100%;
  height: 382px;
  min-height: 382px;
  min-width: 0;
  overflow: hidden;
  overflow-anchor: none;
  contain: layout paint;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  box-shadow: 0 12px 30px rgba(0, 0, 0, .12);
  animation: chart-enter .28s ease-out both;
}

.chart .js-plotly-plot,
.chart .plot-container,
.chart .svg-container {
  width: 100% !important;
  height: 380px !important;
}

.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 9px;
  margin: 15px 0;
}

.actions button,
.actions .download {
  border-color: rgba(108, 124, 255, .55);
}

.terminal {
  max-height: 340px;
  padding: 17px;
  overflow: auto;
  white-space: pre-wrap;
  color: #9ce8d8;
  background: #070b12;
  border: 1px solid #263247;
  border-radius: 12px;
  font: 400 11px/1.65 JetBrains Mono, monospace;
  box-shadow: inset 0 0 30px rgba(0, 0, 0, .2);
}

.terminal.tall {
  max-height: 540px;
}

SIMULATION MODEtable-container {
  border: 1px solid var(--border);
  border-radius: 12px;
  overflow: hidden;
}

/* TSN timeline */
.timeline {
  display: grid;
  grid-template-columns: 1fr 2fr 3fr 4fr;
  margin: 22px 0;
  overflow: hidden;
  border-radius: 12px;
  box-shadow: var(--shadow);
}

.slot {
  display: grid;
  place-items: center;
  min-height: 82px;
  padding: 16px 8px;
  color: #fff;
  text-align: center;
  white-space: pre-line;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .5px;
}

.safety {
  background: linear-gradient(145deg, #c7435b, #81283a);
}

.control {
  background: linear-gradient(145deg, #2879a5, #164560);
}

.adas {
  background: linear-gradient(145deg, #765dc2, #493779);
}

.normal {
  background: linear-gradient(145deg, #278b78, #175447);
}

/* Plotly is explicitly dark to match the complete theme */
.js-plotly-plot,
.plot-container,
.svg-container {
  border-radius: var(--radius);
}

@keyframes status-pulse {
  0% { box-shadow: 0 0 0 0 rgba(47, 214, 155, .5); }
  70%, 100% { box-shadow: 0 0 0 9px rgba(47, 214, 155, 0); }
}

@keyframes chart-enter {
  from { opacity: 0; transform: translateY(5px); }
  to { opacity: 1; transform: translateY(0); }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: .01ms !important;
  }
}

/* Scrollbars */
::-webkit-scrollbar {
  width: 9px;
  height: 9px;
}

::-webkit-scrollbar-track {
  background: #0e1320;
}

::-webkit-scrollbar-thumb {
  background: #3d4960;
  border: 2px solid #0e1320;
  border-radius: 20px;
}

::-webkit-scrollbar-thumb:hover {
  background: #58657d;
}

/* Tablet */
@media (max-width: 1180px) {
  .sidebar {
    width: 250px;
    padding: 22px 17px;
  }

  .main {
    margin-left: 250px;
    padding-inline: 22px;
  }

  .kpi-grid {
    grid-template-columns: repeat(3, minmax(130px, 1fr));
  }

  .node {
    flex: 0 0 125px;
  }
}

/* Mobile and narrow tablet */
@media (max-width: 820px) {
  body {
    overflow-x: hidden;
  }

  .sidebar {
    position: relative;
    inset: auto;
    width: 100%;
    max-height: none;
    padding: 18px;
    border-right: 0;
    border-bottom: 1px solid var(--border);
  }

  .brand {
    margin-bottom: 18px;
  }

  .sidebar>label {
    margin-top: 12px;
  }

  .controls {
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }

  .controls button {
    min-width: 0;
    padding-inline: 5px;
    font-size: 9px;
  }

  .nav {
    display: grid !important;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 5px;
  }

  .nav label.nav-item {
    justify-content: flex-start;
    min-width: 0;
    padding: 8px !important;
    font-size: 10px;
  }

  .disclaimer {
    margin-top: 16px;
  }

  .main {
    margin-left: 0;
    padding: 20px 16px 38px;
  }

  header {
    align-items: flex-start;
  }

  .kpi-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .two {
    grid-template-columns: 1fr;
  }

  .flow {
    padding: 13px;
  }

  .timeline {
    grid-template-columns: repeat(2, 1fr);
  }
}

/* Small phones */
@media (max-width: 500px) {
  .sidebar {
    padding: 16px 13px;
  }

  .brand b {
    font-size: 18px;
  }

  .brand small {
    font-size: 10px;
    letter-spacing: 2px;
  }

  .logo {
    width: 44px;
    height: 44px;
  }

  .controls {
    grid-template-columns: repeat(2, 1fr);
  }

  .controls button:last-child {
    grid-column: 1 / -1;
  }

  .nav {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  header {
    flex-direction: column;
    gap: 10px;
  }

  .main {
    padding-inline: 12px;
  }

  .kpi-grid {
    grid-template-columns: 1fr 1fr;
    gap: 9px;
  }

  .kpi {
    min-height: 86px;
    padding: 13px;
  }

  .kpi strong {
    font-size: 15px;
  }

  .actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .actions>* {
    text-align: center;
  }

  .timeline {
    grid-template-columns: 1fr;
  }

  .slot {
    min-height: 60px;
  }
}

@media (max-width: 820px) {
  .chart,
  .chart .js-plotly-plot,
  .chart .plot-container,
  .chart .svg-container {
    height: 340px !important;
    min-height: 340px;
  }
}

@media (max-width: 500px) {
  .chart,
  .chart .js-plotly-plot,
  .chart .plot-container,
  .chart .svg-container {
    height: 310px !important;
    min-height: 310px;
  }
}
